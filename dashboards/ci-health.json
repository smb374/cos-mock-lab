{
  "uid": "ci-health",
  "title": "CI health",
  "tags": [
    "ci",
    "concourse"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "prometheusds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Build success rate by job, 24 h",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "sum by (job) (increase(concourse_builds_finished{status=\"succeeded\"}[24h])) / sum by (job) (increase(concourse_builds_finished[24h]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Build duration p50 and p95 by job",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, job) (rate(concourse_builds_duration_seconds_bucket[1h])))",
          "legendFormat": "p50 {{job}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(concourse_builds_duration_seconds_bucket[1h])))",
          "legendFormat": "p95 {{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Time since last successful build",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "time() - max by (job) (max_over_time((timestamp(concourse_builds_finished{status=\"succeeded\"}) and (changes(concourse_builds_finished{status=\"succeeded\"}[10m]) > 0))[24h:1m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Workers by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "sum by (state) (concourse_workers_registered)",
          "legendFormat": "{{state}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Swift artifact age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "lab_swift_artifact_age_seconds",
          "legendFormat": "{{artifact}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Launchpad build state (1 ok, 0 failed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "lab_lp_build_state",
          "legendFormat": "{{livefs}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "GitHub run state (1 ok, 0 failed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheusds}"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheusds}"
          },
          "expr": "lab_github_run_state",
          "legendFormat": "{{workflow}}",
          "range": true
        }
      ]
    }
  ]
}
